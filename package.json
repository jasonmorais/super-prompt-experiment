{
	"name": "agentcourses",
	"version": "1.0.0",
	"description": "AgentCourses — a bare-bones application scaffold built on the Cellix framework.",
	"type": "module",
	"author": "AgentCourses",
	"license": "MIT",
	"packageManager": "pnpm@11.9.0",
	"scripts": {
		"prebuild": "pnpm gen",
		"build": "turbo run build",
		"predev": "pnpm gen",
		"dev": "turbo run dev",
		"pretest": "pnpm gen",
		"test": "turbo run test",
		"verify": "turbo run lint build test format:check --filter=@apps/api --filter=@apps/docs --filter=@apps/ui-portal --filter=@axc/* --filter=@axc-verification/*",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"format:check": "turbo run format:check",
		"gen": "graphql-codegen --config codegen.yml",
		"clean": "turbo run clean && rimraf dist node_modules **/coverage",
		"start": "turbo run build && turbo run start",
		"start:api": "pnpm --filter @apps/api start",
		"start:ui-portal": "pnpm --filter @apps/ui-portal start",
		"start-emulator:mongo-memory-server": "pnpm --filter @apps/server-mongodb-memory-mock start",
		"start-emulator:auth-server": "pnpm --filter @apps/server-oauth2-mock start"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@cellix/graphql-codegen": "workspace:*",
		"@graphql-codegen/cli": "^5.0.7",
		"@graphql-codegen/typescript": "^4.1.6",
		"@graphql-codegen/typescript-resolvers": "^4.5.1",
		"@types/node": "catalog:",
		"@typescript/native-preview": "catalog:",
		"@vitest/coverage-istanbul": "catalog:",
		"concurrently": "^9.1.2",
		"rimraf": "^6.0.1",
		"ts-scope-trimmer-plugin": "^1.0.2",
		"turbo": "2.9.18",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=22"
	}
}
