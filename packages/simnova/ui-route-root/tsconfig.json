{
	"extends": "@cellix/config-typescript/base",
	"compilerOptions": {
		"noEmit": true,
		"jsx": "react-jsx",
		"lib": [
			"ES2023",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"composite": false,
		"exactOptionalPropertyTypes": false,
		"skipLibCheck": true
	},
	"include": [
		"src"
	]
}
