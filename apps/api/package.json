{
	"name": "@apps/api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsgo --build && tsgo --noEmit --project tsconfig.rolldown.json && rolldown -c rolldown.config.ts",
		"predev": "pnpm run prepare:deploy && node scripts/ensure-local-settings.mjs",
		"dev": "func start --typescript --script-root deploy/ --port 7071 --cors *",
		"prepare:deploy": "cellix-prepare-func-deploy",
		"watch": "tsgo --watch",
		"test": "vitest run --silent --reporter=dot",
		"clean": "rimraf dist deploy",
		"prestart": "pnpm run prepare:deploy && node scripts/ensure-local-settings.mjs",
		"start": "func start --typescript --script-root deploy/ --port 7071",
		"lint": "biome lint",
		"format": "biome format --write",
		"format:check": "biome format .",
		"prebuild": "pnpm run lint"
	},
	"dependencies": {
		"@azure/functions": "catalog:",
		"@cellix/api-services-spec": "workspace:*",
		"@cellix/mongoose-seedwork": "workspace:*",
		"@simnova/application-services": "workspace:*",
		"@simnova/context-spec": "workspace:*",
		"@simnova/event-handler": "workspace:*",
		"@simnova/graphql": "workspace:*",
		"@simnova/graphql-handler": "workspace:*",
		"@simnova/persistence": "workspace:*",
		"@simnova/rest": "workspace:*",
		"@simnova/service-apollo-server": "workspace:*",
		"@simnova/service-blob-storage": "workspace:*",
		"@simnova/service-mongoose": "workspace:*",
		"@simnova/service-queue-storage": "workspace:*",
		"@simnova/service-otel": "workspace:*",
		"@simnova/service-token-validation": "workspace:*",
		"@opentelemetry/api": "1.9.0"
	},
	"devDependencies": {
		"@cellix/config-rolldown": "workspace:*",
		"@cellix/config-typescript": "workspace:*",
		"rimraf": "catalog:",
		"rolldown": "1.0.0-beta.55",
		"typescript": "catalog:",
		"undici-types": "^6.21.0"
	}
}
