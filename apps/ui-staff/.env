# Local development wiring for the LearnSphere staff portal.
# Points the portal at the local API (@apps/api) and the mock OAuth2 server
# (@apps/server-oauth2-mock) through the portless local HTTPS proxy.
# See apps/docs/docs/decisions/0028-portless-local-development.md for
# canonical proxy start/stop commands; scripts are defined in package.json.
VITE_APP_UI_STAFF_BASE_URL=https://staff.learnsphere.localhost:1355
VITE_COMMON_API_ENDPOINT=https://data-access.learnsphere.localhost:1355/api/graphql
VITE_APP_UI_STAFF_AUTHORITY=https://mock-auth.learnsphere.localhost:1355/staff-user
VITE_APP_UI_STAFF_CLIENTID=mock-staff-client
VITE_APP_UI_STAFF_REDIRECT_URI=https://staff.learnsphere.localhost:1355/auth-redirect
VITE_APP_UI_STAFF_SCOPES=openid
