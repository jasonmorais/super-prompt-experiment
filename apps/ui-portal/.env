# Local development wiring for the AgentCourses portal.
# Points the portal at the local API (@apps/api) and the mock OAuth2 server
# (@apps/server-oauth2-mock). Override per-developer values in .env.local.
# Relative path -> served through the Vite dev proxy (see vite.config.ts),
# keeping the browser on a single origin to avoid CORS.
VITE_COMMON_API_ENDPOINT=/api/graphql
VITE_APP_UI_PORTAL_AUTHORITY=http://localhost:1355/portal-user
VITE_APP_UI_PORTAL_CLIENTID=mock-client
VITE_APP_UI_PORTAL_REDIRECT_URI=http://localhost:3000/auth-redirect
VITE_APP_UI_PORTAL_SCOPES=openid
