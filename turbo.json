{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalPassThroughEnv": [
		"WORKTREE_NAME"
	],
	"futureFlags": {
		"affectedUsingTaskInputs": true,
		"watchUsingTaskInputs": true
	},
	"tasks": {
		"build": {
			"description": "Compiles TypeScript and bundles each package",
			"dependsOn": [
				"^build"
			],
			"inputs": [
				"src/**/*.ts",
				"src/**/*.tsx",
				"src/**/*.mts",
				"src/**/*.cts",
				"src/**/*.json",
				"tsconfig*.json",
				"rolldown.config.ts",
				"!coverage/**",
				"!**/*.test.*",
				"!vitest*.config.*"
			],
			"outputs": [
				"dist/**",
				"build/**",
				"*.tsbuildinfo"
			]
		},
		"test": {
			"description": "Runs the default test suite for each package",
			"dependsOn": [
				"^build",
				"@cellix/config-vitest#build"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				"**/*.test.ts",
				"!coverage/**",
				"!dist/**",
				"!build/**"
			]
		},
		"test:coverage": {
			"description": "Runs the coverage test suite and writes coverage reports",
			"dependsOn": [
				"build",
				"^build",
				"@cellix/config-vitest#build"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				"**/*.test.ts",
				"!coverage/**",
				"!dist/**",
				"!build/**"
			],
			"outputs": [
				"coverage/**"
			]
		},
		"test:watch": {
			"description": "Runs tests in watch mode for active packages",
			"dependsOn": [
				"build",
				"^build"
			],
			"cache": false,
			"persistent": true
		},
		"storybook": {
			"description": "Starts Storybook for packages that expose it",
			"dependsOn": [
				"^build"
			],
			"cache": false,
			"persistent": true
		},
		"start": {
			"description": "Starts long-running package start scripts",
			"cache": false,
			"persistent": true
		},
		"dev": {
			"description": "Starts application packages dev servers in watch mode",
			"dependsOn": [
				"^build"
			],
			"cache": false,
			"persistent": true
		},
		"dev:worktree": {
			"description": "Starts dev servers with worktree-scoped hostnames for git worktree isolation",
			"dependsOn": [
				"^build"
			],
			"cache": false,
			"persistent": true
		},
		"azurite": {
			"description": "Starts the Azurite storage emulator",
			"cache": false,
			"persistent": true
		},
		"clean": {
			"description": "Removes generated build artifacts and caches",
			"cache": false,
			"outputs": []
		}
	}
}
